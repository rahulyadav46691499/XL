# Backend settings. Copy to .env and fill in. See SETUP.md.

# LLM keys: the defaults behind the app's LLM settings (llm_config.json).
# GEMINI_API_KEY also embeds resumes and JDs for search.
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ── AI phone calls on Sarvam Voice Agents (backend/voice/). See SETUP.md §4. ──

# Voice Agents API key: Voice Agents dashboard -> Settings -> API Key.
# NOT the same key as SARVAM_API_KEY below; that one is rejected here.
SARVAM_VOICE_AGENTS_API_KEY=

# This workspace and the agent built for TalentAI (backend/voice/agent_config.json).
# Which committed version a call runs comes with its voice: VOICES in voice/calls.py.
SARVAM_ORG_ID=019f7b93-4337-7933-aac5-cf1487351d6f
SARVAM_WORKSPACE_ID=019f7b93-434a-7a5b-9255-655ae1293fea
SARVAM_AGENT_ID=TalentAI-HR-4a763f40-8322

# The number calls go out from: Deploy -> Phone Numbers. Rent one from Sarvam,
# or connect Exotel / Vobiz / Plivo. The connection id and the number exactly
# as Sarvam stores it (E.164).
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# The inbound deployment that answers candidates who ring the number back
# (Deploy -> Inbounds). Optional: without it callbacks go unanswered.
SARVAM_DEPLOYMENT_ID=TalentAI-ca-cbb289a0-6196

# Public https URL of this backend (port 8000), for Sarvam's call-end webhook.
# Only the webhook is reachable through it (voice/calls.py:tunnel_guard). Optional:
# without it results are fetched from Sarvam's analytics a few minutes after
# each call instead.
PUBLIC_URL=

# Model API key (dashboard.sarvam.ai), only for the HR voice-preview clip.
SARVAM_API_KEY=

# What a call costs, for Collective analysis (docs.sarvam.ai/voice-agents/pricing).
# Per started minute on your plan: 3.5 pay as you go, 3.25 Pro, 3.15 Growth, 3 Business.
SARVAM_RATE_PER_MINUTE=3.5
# Sarvam telephony (Vobiz), per started 30 seconds. 0 if you bring your own provider.
SARVAM_TELEPHONY_PER_PULSE=0.2
# Sarvam has no API for the credit balance, so the "Credits left" tile is this
# figure, as the billing page (indus.sarvam.ai/billing) showed it at the time
# below, less every call since. Leave the time empty if the figure is every
# credit ever added. Leave both empty to show a dash.
SARVAM_CREDIT_BALANCE=
SARVAM_CREDIT_BALANCE_AT=
# The total of Sarvam's usage export (billing page -> usage CSV, product
# samvaad-conversations) at that same time. The "Total spent" tile shows it plus
# calls since; empty, the tile estimates from the agent's calls instead.
SARVAM_SPENT=
